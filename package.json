{
  "name": "snapmeet",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that applies real-time meme effects to your outgoing Google Meet camera feed.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "vite --config vite.playground.config.ts",
    "playground": "vite --config vite.playground.config.ts",
    "build": "node scripts/verify-assets.mjs && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:probes": "SNAPMEET_PROBES=1 playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
